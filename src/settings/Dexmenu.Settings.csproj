<Project Sdk="Microsoft.NET.Sdk">

  <!-- The settings app (docs/plans/01-PLAN-dexmenu.md 3.7, 02-PLAN-own-menu.md 3.5, 3.8; plan 00 step 4): the layout
       edited on the left (a WebView2 page), the menu previewed on the right, drawn by DexmenuShell.dll itself.
       Built into the repository's bin, next to DexmenuShell.dll, which it loads (64-bit, as the DLL). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>false</SelfContained>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AssemblyName>DexmenuSettings</AssemblyName>
    <RootNamespace>Dexmenu.Settings</RootNamespace>
    <!-- a publish builds in its own folder, so a running app in bin does not stop it -->
    <OutDir Condition="'$(_IsPublishing)' != 'true'">$(MSBuildThisFileDirectory)..\..\bin\</OutDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <WebView2NeverCopyLoaderDllToOutputDirectory>true</WebView2NeverCopyLoaderDllToOutputDirectory>
  </PropertyGroup>

  <ItemGroup>
    <!-- The page, served from bin\web through a virtual host. -->
    <Content Include="web\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- DexmenuShell.dll, the Delphi build's artifact (build.cmd compiles it into obj\dll), goes into a publish next to
       the app. Not copied on a build: build.cmd puts it in bin itself, renaming the old one when Explorer holds it. -->
  <PropertyGroup>
    <DexmenuShellDll>$(MSBuildThisFileDirectory)..\..\obj\dll\DexmenuShell.dll</DexmenuShellDll>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(DexmenuShellDll)" Link="DexmenuShell.dll" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireDexmenuShellDll" BeforeTargets="PrepareForPublish">
    <Error Condition="!Exists('$(DexmenuShellDll)')" Text="DexmenuShell.dll is not built: run build.cmd first (it compiles the Delphi DLL into obj\dll)." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

</Project>
