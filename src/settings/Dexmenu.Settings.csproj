<Project Sdk="Microsoft.NET.Sdk">

  <!-- The settings app (docs/plans/01-PLAN-dexmenu.md 3.7, executed/02-PLAN-own-menu.md 3.5, 3.8; plan 00 step 4): the layout
       edited on the left (a WebView2 page), the menu previewed on the right, drawn by DexmenuShell.dll itself.
       Built into the repository's bin, next to DexmenuShell.dll, which it loads (64-bit, as the DLL).
       A publish (as Foldex and LexPen): one exe, with only DexmenuShell.dll and WebView2Loader.dll next to it. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Major.minor; the last number is the git commit count (see GitVersion), as Foldex's and LexPen's. -->
    <VersionBase>1.0</VersionBase>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AssemblyName>DexmenuSettings</AssemblyName>
    <RootNamespace>Dexmenu.Settings</RootNamespace>
    <!-- a publish builds in its own folder, so a running app in bin does not stop it -->
    <OutDir Condition="'$(_IsPublishing)' != 'true'">$(MSBuildThisFileDirectory)..\..\bin\</OutDir>
    <!-- not a publish: the page served from the project's own web folder (WebFiles), an edit applies on a reload -->
    <DefineConstants Condition="'$(_IsPublishing)' != 'true'">$(DefineConstants);PROJECT_WEB</DefineConstants>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Publish only what runs: no symbols, no IntelliSense xml, and no second WebView2Loader.dll under runtimes\ (the
         package's native asset already puts one next to the exe). -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <WebView2NeverCopyLoaderDllToOutputDirectory>true</WebView2NeverCopyLoaderDllToOutputDirectory>
    <!-- One exe: DexmenuSettings.dll, its .NET json files and the libraries inside; the native DLLs (DexmenuShell.dll,
         WebView2Loader.dll) stay next to it, so nothing is unpacked to a temp folder. -->
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The page's files: inside the exe (WebFiles). -->
    <EmbeddedResource Include="web\**" LogicalName="web\%(RecursiveDir)%(Filename)%(Extension)" />
    <AssemblyMetadata Include="BuildTime" Value="$([System.DateTime]::UtcNow.ToString('o'))" />
  </ItemGroup>

  <!-- The build number is the git commit count, so each commit gets its own version: 1.0.1, 1.0.2, ...
       The short commit hash goes into the assembly metadata. Without git it is 1.0.0. Skipped for the IDE's
       background design-time builds. -->
  <Target Name="GitVersion" BeforeTargets="BeforeBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="git rev-list --count HEAD" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" EchoOff="true" StandardOutputImportance="low" StandardErrorImportance="low" IgnoreExitCode="true" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="BuildNumber" />
      <Output TaskParameter="ExitCode" PropertyName="GitExitCode" />
    </Exec>
    <Exec Command="git rev-parse --short HEAD" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" EchoOff="true" StandardOutputImportance="low" StandardErrorImportance="low" IgnoreExitCode="true" ContinueOnError="true" Condition="'$(GitExitCode)' == '0'">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommit" />
    </Exec>
    <PropertyGroup>
      <BuildNumber Condition="'$(GitExitCode)' != '0'">0</BuildNumber>
      <Version>$(VersionBase).$(BuildNumber)</Version>
    </PropertyGroup>
    <ItemGroup Condition="'$(GitCommit)' != ''">
      <AssemblyMetadata Include="Commit" Value="$(GitCommit)" />
    </ItemGroup>
    <Message Importance="high" Text="Dexmenu version $(Version) $(GitCommit)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <!-- DexmenuShell.dll, the Delphi build's artifact (build.cmd compiles it into obj\dll), into a publish next to the
       exe; not on a build: build.cmd puts it in bin itself. Into the publish folder even while Explorer holds the one
       there (it keeps a DLL it loaded open, until it restarts): that one is renamed first (allowed while it is loaded),
       and old ones no longer held are removed (as LexPen's). -->
  <PropertyGroup>
    <DexmenuShellDll>$(MSBuildThisFileDirectory)..\..\obj\dll\DexmenuShell.dll</DexmenuShellDll>
  </PropertyGroup>
  <Target Name="RequireDexmenuShellDll" BeforeTargets="PrepareForPublish">
    <Error Condition="!Exists('$(DexmenuShellDll)')" Text="DexmenuShell.dll is not built: run build.cmd first (it compiles the Delphi DLL into obj\dll)." />
  </Target>
  <Target Name="PublishDexmenuShell" AfterTargets="Publish">
    <ItemGroup>
      <OldShellDll Include="$(PublishDir)\DexmenuShell.*.old" />
    </ItemGroup>
    <Delete Files="@(OldShellDll)" ContinueOnError="true" />
    <Move SourceFiles="$(PublishDir)\DexmenuShell.dll" DestinationFiles="$(PublishDir)\DexmenuShell.$([System.Guid]::NewGuid().ToString('N')).old"
          Condition="Exists('$(PublishDir)\DexmenuShell.dll')" ContinueOnError="true" />
    <Copy SourceFiles="$(DexmenuShellDll)" DestinationFolder="$(PublishDir)" />
    <ItemGroup>
      <MovedShellDll Include="$(PublishDir)\DexmenuShell.*.old" />
    </ItemGroup>
    <Delete Files="@(MovedShellDll)" ContinueOnError="true" />
  </Target>

  <!-- The WebView2 package always references its WPF control too; this app only uses WinForms. -->
  <Target Name="DropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
